source_hpp %{

#include "gc/shared/gc_globals.hpp"
#include "gc/z/c2/zBarrierSetC2.hpp"
#include "gc/z/zThreadLocalData.hpp"
#include "gc/shared/c2/patchingBarrierSetC2.hpp"

%}

source %{

#include "gc/z/zBarrierSetAssembler.hpp"
#include "gc/shared/patchingBarrierSetAssembler.hpp"
#include "gc/shared/patchingBarrierRelocation.hpp"

static void pb_uncolor(MacroAssembler* masm, const MachNode* node, Register ref) {
  // Perform a left shift on the 64-bit value. This will be patched by ZGC to be the correct offset.
  // Otherwise, we are running without compression so this is a no-op.
  __ relocate(barrier_Relocation::spec(), PatchingBarrierRelocationFormatShiftLsr);
  __ lsr(ref, ref, barrier_Relocation::unpatched);
}

static void pb_load_weak(MacroAssembler* masm, 
                         const MachNode* node, 
                         bool narrow,
                         Address ref_addr,
                         Register ref,
                         Register tmp1,
                         Register tmp2,
                         Register tmp3) {
  // Exclude the barrier code from the instruction counter heuristic.
  Assembler::InlineSkippedInstructionsCounter skipped_counter(masm);
  __ block_comment("pb_load_weak START");
  // First, we determine where the SATB value will be in memory in G1.
  Address in_progress(rthread, in_bytes(G1ThreadLocalData::satb_mark_queue_active_offset()));
  // Prepare all of the slow paths.
  PatchingBarrierSlowPathPackageC2 pack = PatchingBarrierSetAssembler::slow_path_c2(masm, node, ref_addr, ref, tmp1, tmp2, tmp3);

  // Register allocation:
  // tmp1: the register in which we load "the thing to test". Callee saved.
  // tmp2, tmp3: G1 temp registers for slow path, also callee saved.

  // This is the G1 address, but all other GC will set this to a mov with immediate 0.
  __ relocate(barrier_Relocation::spec(), PatchingBarrierRelocationFormatGetStateBeforeLdrX);
  // lrdb tmp, address or ldrw tmp, address
  // For simplification, we assume that this is always 1 byte wide on AArch64.
  // The tmp2 corresponds to the tmp1 in the G1 source code. It's very confusing.
  __ ldrb(tmp2, in_progress);
  // G1 barrier, take the branch if SATB is active. Will never trigger for the other GC.
  __ cbnzw(tmp2, *pack._g1_entry);

  // For ZGC, load the current mask. All other GC will use the default setting.
  __ relocate(barrier_Relocation::spec(), PatchingBarrierRelocationFormatMarkBadBeforeMov);
  __ movzw(tmp1, barrier_Relocation::unpatched);
  // This will always be equal for other GC.
  __ tst(ref, tmp1);
  // Z barrier, take branch if the pointer needs to be fixed. Will never trigger for the other GC.
  __ br(Assembler::NE, *pack._z_entry);

  // If running non-narrow, we will have ZGC. This needs to decompress.
  if (!narrow) {
    pb_uncolor(masm, node, ref);
  }

  __ block_comment("pb_load_weak END");
  // We have to bind all of the stubs.
  __ bind(*pack._g1_continuation);
  __ bind(*pack._z_continuation);
}

static void pb_load_strong(MacroAssembler* masm, 
                           const MachNode* node, 
                           Address ref_addr, 
                           Register ref,
                           Register tmp) {
  // Exclude the barrier code from instruction counter heuristic.
  Assembler::InlineSkippedInstructionsCounter skipped_counter(masm);
  __ block_comment("pb_load_strong START");

  // If there is barrier elision, this must be done otherwise there will be many problems.
  if ((node->barrier_data() & PatchingBarrierElided) != 0) {
    // If running ZGC, this will handle compression.
    pb_uncolor(masm, node, ref);
    return;
  }

  // There is only one slow path, which belongs to ZGC. Prepare the stub.
  ZLoadBarrierStubC2Aarch64* const stub = ZLoadBarrierStubC2Aarch64::create(node, ref_addr, ref);
  // We have to check if we need to do any fixups in ZGC. This should be a no-op for the other GCs.
  // tb(n)z xzr, #imm, good
  // The relocation indicates to ZGC to patch the immediate to the correct mask.
  // Enable trampolining like in ZGC.
  if (stub->is_test_and_branch_reachable()) {
    // The normal case where the stub is reachable within a tbnz.
    __ relocate(barrier_Relocation::spec(), PatchingBarrierRelocationFormatLoadGoodBeforeTbX);
    __ tbnz(ref, barrier_Relocation::unpatched, *stub->entry());
  } else {
    // We will assume the worst case scenario where a test is not reachable.
    Label good;
    __ relocate(barrier_Relocation::spec(), PatchingBarrierRelocationFormatLoadGoodBeforeTbX);
    __ tbz(ref, barrier_Relocation::unpatched, good);
    // Trampoline, boink!
    __ b(*stub->entry());
    __ bind(good);
  }

  // If running ZGC, this will handle compression.
  // This will never get called on narrow oops.
  pb_uncolor(masm, node, ref);

  __ block_comment("pb_load_strong END");
  __ bind(*stub->continuation());
}

// This writes the correct barrier for the correct load type (strong vs weak).
static void pb_dispatch(MacroAssembler* masm, 
                        const MachNode* node, 
                        bool narrow,
                        Address ref_addr, 
                        Register ref,
                        Register tmp1,
                        Register tmp2,
                        Register tmp3) {
  // The barrier data holds what type of reference it is. In this case, a weak reference is either a weak or phantom reference, which are both set with bitmasks.
  const bool on_non_strong =
      ((node->barrier_data() & PatchingBarrierWeak) != 0) ||
      ((node->barrier_data() & PatchingBarrierPhantom) != 0);
  if (on_non_strong) {
    __ decode_heap_oop(tmp1, ref);
    // Weak load barrier.
    pb_load_weak(masm, node, narrow, ref_addr, ref, tmp1, tmp2, tmp3);
  } else if (!narrow) {
    // When running on compression, we can never use ZGC so a strong load barrier is never needed.
    // Strong load barrier, only needs one temporary register.
    pb_load_strong(masm, node, ref_addr, ref, tmp1);
  }
}

%}

//
// Two matching blocks to rule them all (+ volatile/nonvolatile)!
// We have LoadP for uncompressed archives, and LoadN for compressed archives.
//

instruct patchingBarrierLoadN(iRegNNoSp dst, indirect mem, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate((UseSerialGC || UseParallelGC || UseG1GC) && UseLoadPB && !needs_acquiring_load(n) && n->as_Load()->barrier_data() != 0);
  match(Set dst (LoadN mem));
  effect(TEMP dst, TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);

  ins_cost(4 * INSN_COST); 
  format %{ "ldrw  $dst, $mem\t# compressed ptr" %}

  ins_encode %{
    const Address ref_addr = Address($mem$$Register);
    __ ldrw($dst$$Register, $mem$$Register);
    pb_dispatch(masm, this, true, ref_addr, $dst$$Register, $tmp1$$Register, $tmp2$$Register, $tmp3$$Register);
  %}

  ins_pipe(iload_reg_mem);
%}

instruct patchingBarrierLoadNVolatile(iRegNNoSp dst, indirect mem /* sync_memory */, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate((UseSerialGC || UseParallelGC || UseG1GC) && UseLoadPB && needs_acquiring_load(n) && n->as_Load()->barrier_data() != 0);
  match(Set dst (LoadN mem));
  effect(TEMP dst, TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);

  ins_cost(VOLATILE_REF_COST);
  format %{ "ldarw  $dst, $mem\t# compressed ptr" %}

  ins_encode %{
    const Address ref_addr = Address($mem$$Register);
    __ ldarw($dst$$Register, $mem$$Register);
    pb_dispatch(masm, this, true, ref_addr, $dst$$Register, $tmp1$$Register, $tmp2$$Register, $tmp3$$Register);
  %}

  ins_pipe(pipe_serial);
%}

instruct patchingBarrierLoadP(iRegPNoSp dst, indirect mem, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate((UseSerialGC || UseParallelGC || UseG1GC || UseZGC) && UseLoadPB && !needs_acquiring_load(n) && n->as_Load()->barrier_data() != 0);
  match(Set dst (LoadP mem));
  effect(TEMP dst, TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);

  ins_cost(4 * INSN_COST);
  format %{ "ldr  $dst, $mem" %}

  ins_encode %{
    const Address ref_addr = Address($mem$$Register);
    __ ldr($dst$$Register, ref_addr);
    pb_dispatch(masm, this, false, ref_addr, $dst$$Register, $tmp1$$Register, $tmp2$$Register, $tmp3$$Register);
  %}

  ins_pipe(iload_reg_mem);
%}

instruct patchingBarrierLoadPVolatile(iRegPNoSp dst, indirect mem /* sync_memory */, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate((UseSerialGC || UseParallelGC || UseG1GC || UseZGC) && UseLoadPB && needs_acquiring_load(n) && n->as_Load()->barrier_data() != 0);
  match(Set dst (LoadP mem));
  effect(TEMP dst, TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);

  ins_cost(VOLATILE_REF_COST);
  format %{ "ldar  $dst, $mem\t" %}

  ins_encode %{
    const Address ref_addr = Address($mem$$Register);
    __ ldar($dst$$Register, $mem$$Register);
    pb_dispatch(masm, this, false, ref_addr, $dst$$Register, $tmp1$$Register, $tmp2$$Register, $tmp3$$Register);
  %}

  ins_pipe(iload_reg_mem);
%}

